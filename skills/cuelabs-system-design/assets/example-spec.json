    {
      "id": "rules",
      "type": "rules",
      "title": "The three rules",
      "items": [
        {"title": "Go only does CRUD.", "text": "<code>api/common</code> is the only service that opens Postgres. It saves decisions; it never makes them."},
        {"title": "Python makes every decision.", "text": "Parsing, categories, duplicates and anomalies all happen in <code>api/process</code>."},
        {"title": "Nothing talks synchronously.", "text": "Every handoff goes through Kafka. Python gets its reference data inside the message."}
      ]
    },
    {
