    {
      "id": "capture",
      "type": "sequence",
      "title": "One receipt upload",
      "caption": "<strong><code>common</code> says yes before the photo leaves the phone.</strong> Creating the receipt checks limits and consent, then returns a signed ticket. The photo sits in <code>tmp/</code> only until <code>api/process</code> reports back.",
      "sequence": {
        "aria": "Sequence for one receipt upload: the app creates the receipt on api/common and gets a ticket, uploads the photo to api/intake, which stores it and sends a pointer to Kafka; api/common forwards it with reference data; api/process parses and categorizes it and returns the result; api/common stores it and deletes the photo.",
        "lanes": [
          {"id": "app", "title": "Mobile app", "sub": "user's phone", "kind": "client"},
          {"id": "gw", "title": "api/intake", "sub": "Node gateway", "kind": "service"},
          {"id": "gcs", "title": "Cloud Storage", "sub": "tmp/", "kind": "store"},
          {"id": "k", "title": "Kafka", "sub": "Aiven", "kind": "bus"},
          {"id": "c", "title": "api/common", "sub": "Go · CRUD", "kind": "service"},
          {"id": "p", "title": "api/process", "sub": "Python", "kind": "python"}
        ],
        "steps": [
          {"from": "app", "to": "c", "text": "POST /receipts {size} · Idempotency-Key"},
          {"note": "limits · AI consent · quota", "at": "c"},
          {"from": "c", "to": "app", "kind": "reply", "text": "201 · receipt id + upload ticket"},
          {"from": "app", "to": "gw", "text": "POST /uploads + ticket"},
          {"from": "gw", "to": "gcs", "kind": "storage-write", "text": "put receipt.jpg"},
          {"from": "gw", "to": "k", "kind": "kafka", "text": "upload.received {pointer}"},
          {"from": "k", "to": "c", "kind": "kafka", "text": "upload.received"},
          {"from": "c", "to": "k", "kind": "kafka", "text": "import.ready + categories"},
          {"from": "k", "to": "p", "kind": "kafka", "text": "import.ready"},
          {"from": "p", "to": "gcs", "kind": "storage-read", "text": "read receipt.jpg"},
          {"from": "p", "to": "k", "kind": "kafka", "text": "import.processed"},
          {"from": "k", "to": "c", "kind": "kafka", "text": "import.processed"},
          {"from": "c", "to": "gcs", "kind": "storage-write", "text": "delete receipt.jpg"},
          {"from": "app", "to": "c", "text": "GET /receipts/{id} while polling → completed"}
        ],
        "footer": "The user then reviews the categories and confirms; common writes the ledger rows in one transaction."
      }
