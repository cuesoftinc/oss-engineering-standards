        ["api/common", "Go · CRUD", "Auth, ledger, receipts, review and confirm; authorizes every upload and issues its ticket; outbox; saves every decision Python makes", "Cloud Run service, min 1", {"text": "8080", "class": "num"}],
        ["api/intake", "Node · gateway", "Verifies the upload ticket, checks the file, writes it to temporary storage, sends a pointer to Kafka. Stateless", "Cloud Run service, 0–5", {"text": "8081", "class": "num"}],
        ["api/process", "Python · processing", "Parses receipts, categorizes, flags duplicates and anomalies", "Worker pool", {"text": "8082", "class": "num"}]
      ]
